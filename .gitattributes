
# Empreintes de licences identiques sur les runners Windows, macOS et Linux.
/package-lock.json text eol=lf
/src/frontend/package-lock.json text eol=lf
/src/frontend/src-tauri/Cargo.lock text eol=lf
/uv.lock text eol=lf
/licenses/*.json text eol=lf
/THIRD_PARTY_LICENSES text eol=lf

# Textes complémentaires vérifiés : empreintes identiques sous Windows.
/licenses/supplements/*.txt text eol=lf
/licenses/attribution-sources.json text eol=lf
/licenses/supplements/*.json text eol=lf

# Sources et preuves du quatrième tour
licenses/evidence/*.tar.gz -text
licenses/evidence/*.crate -text
licenses/recipes/* text eol=lf
licenses/copyleft-sources.json text eol=lf
licenses/copyleft-version-evidence.json text eol=lf
scripts/attribution_evidence.py text eol=lf
scripts/copyleft_sources.py text eol=lf

# Preuves et notices système : mêmes octets sur les trois runners.
licenses/system-linux/** text eol=lf
licenses/system-macos/** text eol=lf
licenses/cpython/** text eol=lf
# Notices Windows amont reproduites à l'octet, CRLF compris (normalisées au rendu).
licenses/system-windows/** -text
licenses/LISEZMOI-SOURCES.txt text eol=lf
licenses/supplements/LGPL-2.0.txt text eol=lf

# Conserver les espaces des notices amont reproduites octet pour octet.
THIRD_PARTY_LICENSES whitespace=-blank-at-eol,-blank-at-eof
licenses/system-linux/** whitespace=-blank-at-eol,-blank-at-eof
licenses/cpython/** text eol=lf whitespace=-blank-at-eol,-blank-at-eof
scripts/tests/fixtures/cpython-3.13.17/*.gz -text
