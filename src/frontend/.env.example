# Développement local uniquement.
# Port du backend visé par le frontend avant que initApiBase() ne résolve le
# port réel (paramètre ?port=, puis IPC Tauri). Les E2E isolés le pointent vers
# leur backend jetable au lieu de l'instance réelle (17293).
# VITE_THERESE_INTERFACE_MODE a été retiré le 02/09/2026 (B-066) : son lecteur
# avait disparu avec le mode classique, le gabarit promettait un défaut faux.
VITE_THERESE_BACKEND_PORT=17293
