(version 1)
(deny default)
; Candidat auxiliaire seulement. Aucun startup Chrome natif qualifié.
(allow process-fork process-exec sysctl-read)
(allow file-read* file-map-executable
  (subpath "/System") (subpath "/usr") (subpath "/bin") (subpath "/sbin")
  (subpath "/private/tmp/therese-c17-chrome-qa-copy-RoZmwsja/Google Chrome.app")
  (subpath (param "AUXILIARY_ROOT")) (subpath (param "HOME_ROOT")) (subpath (param "TMP_ROOT"))
  (literal "/dev/null") (literal "/dev/urandom") (literal "/dev/random")
  (literal "/private/etc/localtime") (subpath "/private/var/db/timezone"))
(allow file-read-metadata (literal "/") (literal "/Applications") (literal "/private") (literal "/private/tmp")
  (literal "/private/tmp/therese-c17-chrome-qa-copy-RoZmwsja"))
(allow file-read-metadata (literal "/etc") (literal "/tmp") (literal "/var")
  (literal (param "QA_ROOT")))
(allow mach-lookup
  (global-name "com.apple.coreservices.launchservicesd")
  (global-name "com.apple.windowserver.active"))
(allow file-read-data (literal "/") (literal "/private/tmp")
  (literal (param "QA_ROOT")))
(allow file-write* (subpath (param "AUXILIARY_ROOT")) (subpath (param "HOME_ROOT"))
  (subpath (param "TMP_ROOT")) (literal "/dev/null"))
(allow signal (target self) (target children))
(allow network-bind network-inbound (local ip "localhost:17594"))
(allow network-outbound (remote ip "localhost:17593") (remote ip "localhost:5173"))
; ROOT5 : ProcessSingleton bind() sur TMP_ROOT/com.google.Chrome.*/SingletonSocket
; a échoué EPERM. AF_UNIX + bind local restent bornés au TMP_ROOT privé exact.
(allow system-socket (socket-domain AF_UNIX))
(allow network-bind (local unix-socket (subpath (param "TMP_ROOT"))))
; ROOT6 : le noyau refuse cette classe précise à Chrome PID 25577
; immédiatement avant l'échec IONotificationPortGetRunLoopSource.
(allow iokit-open-user-client (iokit-user-client-class "RootDomainUserClient"))
; Deux lookups UI exacts issus du diagnostic ROOT4 ; aucun Mach global,
; AppleEvents, HOME réel, presse-papiers, profil personnel ou sortie Internet.
; ROOT10 diagnostic_only : refus ciblés, causalité non prouvée, profil non admis.
(allow mach-lookup (global-name "com.apple.CARenderServer"))
(allow iokit-open-user-client (iokit-user-client-class "IOSurfaceRootUserClient"))
(allow iokit-open-user-client (iokit-user-client-class "AGXDeviceUserClient"))
(allow file-read-metadata (literal (param "AUXILIARY_PARENT")))
