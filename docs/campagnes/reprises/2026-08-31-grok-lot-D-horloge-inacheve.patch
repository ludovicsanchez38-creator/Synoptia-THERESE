diff --git a/src/frontend/src/lib/civilDate.ts b/src/frontend/src/lib/civilDate.ts
index 508973df..8470a1a2 100644
--- a/src/frontend/src/lib/civilDate.ts
+++ b/src/frontend/src/lib/civilDate.ts
@@ -12,3 +12,16 @@ export function localDateKey(d: Date): string {
   const day = String(d.getDate()).padStart(2, '0');
   return `${d.getFullYear()}-${month}-${day}`;
 }
+
+/**
+ * Fenêtre d'un mois civil pour un `timeMax` exclusif (Google Calendar).
+ *
+ * Revue 30/08 : minuit local du dernier jour, passé par `toISOString()`,
+ * coupait tout le 31 et le 29 février. On prend minuit local du 1er du
+ * mois suivant.
+ */
+export function fenetreIsoDuMoisCivil(d: Date): { timeMin: string; timeMax: string } {
+  const debut = new Date(d.getFullYear(), d.getMonth(), 1);
+  const finExclusive = new Date(d.getFullYear(), d.getMonth() + 1, 1);
+  return { timeMin: debut.toISOString(), timeMax: finExclusive.toISOString() };
+}
